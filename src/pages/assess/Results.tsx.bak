                    <Radar
                      name="RIASEC"
                      dataKey="score"
                      stroke="#22d3ee"
                      fill="rgba(34, 211, 238, 0.2)"
                      strokeWidth={2}
                      dot={{ fill: 'white', r: 4, strokeWidth: 0 }}
