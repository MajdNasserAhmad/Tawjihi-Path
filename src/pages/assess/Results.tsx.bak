                    <Tooltip
                      contentStyle={{ background: '#050f1a', border: '1px solid rgba(34,211,238,0.3)', borderRadius: 12, fontFamily: 'Cairo' }}
                      formatter={(val: number) => [`${Math.round(val)}%`, '']}
