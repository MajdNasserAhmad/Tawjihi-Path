// ─── Score Label ──────────────────────────────────────────────────────────────
function getScoreLabel(score: number): string {
  if (score >= 80) return 'مستوى مرتفع جداً';
  if (score >= 60) return 'مستوى مرتفع';
  if (score >= 40) return 'مستوى متوسط';
  return 'مستوى منخفض';
}

// ─── Star Rating ──────────────────────────────────────────────────────────────
function StarRating({ rating }: { rating: number }) {
  return (
    <div className="flex gap-0.5">
      {[1, 2, 3, 4, 5].map(i => (
        <Star key={i} className={`w-3.5 h-3.5 ${i <= rating ? 'text-amber-400 fill-amber-400' : 'text-slate-600'}`} />
      ))}
    </div>
  );
}

// ─── Main Component ───────────────────────────────────────────────────────────
export default function Results() {
  const { id } = useParams();
  const navigate = useNavigate();
  const resetAssessment = useAssessmentStore((state) => state.reset);
  const reportRef = useRef<HTMLDivElement>(null);
  const carouselRef = useRef<HTMLDivElement>(null);
  const [result, setResult] = useState<any | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [expandedField, setExpandedField] = useState<string | null>(null);

  // Major modal
  const [selectedMajor, setSelectedMajor] = useState<string | null>(null);
  const [majorDesc, setMajorDesc] = useState<string | null>(null);
  const [loadingDesc, setLoadingDesc] = useState(false);

  // Field careers
  const [fieldCareers, setFieldCareers] = useState<Record<string, { jobs: string[]; majors: string[] }>>({});
  const [loadingCareers, setLoadingCareers] = useState<string | null>(null);

  // Chatbot
  const [isChatOpen, setIsChatOpen] = useState(false);
  const [chatMessages, setChatMessages] = useState<{ role: 'user' | 'assistant'; content: string }[]>([]);
  const [chatInput, setChatInput] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const chatEndRef = useRef<HTMLDivElement>(null);

  // Score counter using hook
  // Guard and multiply score by 100 if it is a decimal stored between 0 and 1
  const rawScore = result?.field_1_score || 0;
  const topScore = rawScore <= 1 && rawScore > 0 ? Math.round(rawScore * 100) : Math.round(rawScore);
  const { count: scoreCount, ref: scoreRef } = useCountUp(topScore, 1800, true);

  useEffect(() => {
    async function fetchResult() {
      if (!id) return;
      try {
        const { data, error: fetchError } = await supabase
          .from('assessment_results').select('*').eq('id', id).single();
        if (fetchError) throw fetchError;
        
        console.log('DEBUG score:', data.field_1_score, typeof data.field_1_score);
        
        const enriched = {
          ...data,
          fields_ranked: [
            { field_id: data.field_1, score: data.field_1_score <= 1 && data.field_1_score > 0 ? data.field_1_score * 100 : data.field_1_score },
            { field_id: data.field_2, score: data.field_2_score <= 1 && data.field_2_score > 0 ? data.field_2_score * 100 : data.field_2_score },
            { field_id: data.field_3, score: data.field_3_score <= 1 && data.field_3_score > 0 ? data.field_3_score * 100 : data.field_3_score },
            { field_id: data.field_4, score: data.field_4_score <= 1 && data.field_4_score > 0 ? data.field_4_score * 100 : data.field_4_score },
          ].filter(f => f.field_id)
        };
        setResult(enriched);
        setExpandedField(data.field_1 || null);
        if (data.field_1) {
          fetchFieldCareers(data.field_1, fieldData[data.field_1 as FieldId]?.name || data.field_1);
        }
      } catch (err: any) {
        setError('تعذر العثور على التقرير المطلوب. يرجى التأكد من الرابط أو إعادة الاختبار.');
      } finally {
        setLoading(false);
      }
    }
    fetchResult();
  }, [id]);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [chatMessages, isTyping]);

  const fetchFieldCareers = async (field_id: string, field_name: string) => {
    if (fieldCareers[field_id]) return;
    setLoadingCareers(field_id);
    try {
      const { data, error } = await supabase.functions.invoke('gemini-service', {
        body: { action: 'field_careers', payload: { field_id, field_name } }
      });
      if (error) throw error;
      if (data?.result) {
        setFieldCareers(prev => ({ ...prev, [field_id]: data.result }));
      }
    } catch (e) {
      setFieldCareers(prev => ({
        ...prev,
        [field_id]: CAREERS_FALLBACK[field_id] || { jobs: [], majors: [] }
      }));
    } finally {
      setLoadingCareers(null);
    }
  };

  const handleFieldExpand = (field_id: string) => {
    const isExpanding = expandedField !== field_id;
    setExpandedField(isExpanding ? field_id : null);
    if (isExpanding) {
      const details = fieldData[field_id as FieldId];
      if (details) fetchFieldCareers(field_id, details.name);
    }
  };

  const handleMajorClick = async (major: string) => {
    setSelectedMajor(major);
    setMajorDesc(null);
    setLoadingDesc(true);
    try {
      const { data, error } = await supabase.functions.invoke('gemini-service', {
        body: { action: 'major_description', payload: { major_name: major } }
      });
      if (error) throw error;
      setMajorDesc(data.result);
    } catch {
      setMajorDesc('عذراً، تعذر جلب وصف التخصص حالياً.');
    } finally {
      setLoadingDesc(false);
    }
  };

  const handleSendMessage = async (e?: React.FormEvent) => {
    if (e) e.preventDefault();
    if (!chatInput.trim() || isTyping || !result) return;
    const userMsg = chatInput.trim();
    setChatInput('');
    setChatMessages(prev => [...prev, { role: 'user', content: userMsg }]);
    setIsTyping(true);
    try {
      const { data, error } = await supabase.functions.invoke('gemini-service', {
        body: { action: 'chatbot', payload: { message: userMsg, context: result, history: chatMessages.slice(-5) } }
      });
      if (error) throw error;
      setChatMessages(prev => [...prev, { role: 'assistant', content: data.result }]);
    } catch {
      setChatMessages(prev => [...prev, { role: 'assistant', content: 'عذراً، واجهت مشكلة. يرجى المحاولة مرة أخرى.' }]);
    } finally {
      setIsTyping(false);
    }
  };

  const handleShare = async () => {
    const shareUrl = `${window.location.origin}/share/${result?.id}`;
    if (navigator.share) await navigator.share({ title: 'نتائج مساري التوجيهي', url: shareUrl });
    else { await navigator.clipboard.writeText(shareUrl); alert('تم نسخ الرابط!'); }
  };

  const scrollCarousel = (ref: React.RefObject<HTMLDivElement>, dir: 'left' | 'right') => {
    if (!ref.current) return;
    const amount = 340;
    ref.current.scrollBy({ left: dir === 'left' ? -amount : amount, behavior: 'smooth' });
  };

  if (loading) return (
    <div className="min-h-screen bg-[#050505] flex flex-col items-center justify-center font-cairo text-white">
      <Loader2 className="w-12 h-12 text-indigo-500 animate-spin mb-4" />
      <p className="text-slate-400 animate-pulse">جاري جلب تقريرك المخصص...</p>
    </div>
  );

  if (error || !result) return (
    <div className="min-h-screen bg-[#050505] flex items-center justify-center p-6 font-cairo text-white">
      <div className="p-8 rounded-2xl border border-red-500/30 bg-red-500/5 text-center max-w-md">
        <AlertCircle className="w-16 h-16 text-red-500 mx-auto mb-6" />
        <h2 className="text-2xl font-bold mb-4">خطأ في استرجاع النتائج</h2>
        <p className="text-slate-400 mb-8">{error}</p>
        <button onClick={() => navigate('/assess/grades')} className="btn-primary w-full">إعادة الاختبار</button>
      </div>
    </div>
  );

  // ── Derived data ──
  const riasecListData = Object.entries({
    R: result.riasec_r, I: result.riasec_i, A: result.riasec_a,
    S: result.riasec_s, E: result.riasec_e, C: result.riasec_c,
  }).map(([key, value]) => ({ key, label: riasecLabels[key], score: value as number }))
    .sort((a, b) => b.score - a.score);

  const bigFiveRadarData = [
    { subject: 'الانفتاح',  score: result.big5_openness || 0 },
    { subject: 'الضمير',    score: result.big5_conscientiousness || 0 },
    { subject: 'الانبساط',  score: result.big5_extraversion || 0 },
    { subject: 'القبول',    score: result.big5_agreeableness || 0 },
    { subject: 'العصبية',  score: result.big5_neuroticism || 0 },
  ];

  const riasecRadarData = [
    { subject: 'واقعي',     score: result.riasec_r || 0 },
    { subject: 'استقصائي', score: result.riasec_i || 0 },
    { subject: 'فني',       score: result.riasec_a || 0 },
    { subject: 'اجتماعي',  score: result.riasec_s || 0 },
    { subject: 'مبادر',    score: result.riasec_e || 0 },
    { subject: 'تقليدي',   score: result.riasec_c || 0 },
  ];

  const topRiasecKey = riasecListData[0]?.key || 'S';
  const personalityBullets = riasecTraits[topRiasecKey] || riasecTraits['S'];

  const topField = result.field_1 as FieldId;
  const topFieldData = fieldData[topField];
  const topFieldCareers = fieldCareers[topField] || CAREERS_FALLBACK[topField] || { jobs: [], majors: [] };
  const universities = UNIVERSITIES_BY_FIELD[topField] || UNIVERSITIES_BY_FIELD['law_sharia_languages'];

  const electiveKeys2: Record<string, string> = electiveKeys;

  return (
    <div className="min-h-screen bg-[#050505] text-white font-cairo pb-24 overflow-x-hidden" dir="rtl">

      {/* Ambient background blobs */}
      <div className="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <div className="absolute top-0 right-0 w-[700px] h-[700px] bg-purple-600/8 rounded-full blur-[180px]" />
        <div className="absolute top-[30%] left-0 w-[500px] h-[500px] bg-cyan-500/5 rounded-full blur-[140px]" />
        <div className="absolute bottom-0 right-[20%] w-[600px] h-[600px] bg-indigo-600/6 rounded-full blur-[160px]" />
      </div>

      <div className="relative z-10">

        {/* ═══════════════════════════════════════════════════════════
            1. HERO SECTION
        ════════════════════════════════════════════════════════════ */}
        <section className="relative min-h-[50vh] flex items-center overflow-hidden pt-28 pb-6">
          <div className="relative w-full max-w-7xl mx-auto px-4 md:px-8">
            <div className="flex flex-col md:flex-row items-center justify-between gap-8">
              {/* Right/Top: success badge and actions */}
              <div className="flex-1 space-y-6 text-right">
                <div className="inline-flex items-center gap-2 bg-indigo-500/10 border border-indigo-500/20 rounded-full px-4 py-2 text-indigo-400 text-sm font-bold">
                  <Trophy className="w-4 h-4" />
                  <span>اكتمل التقييم بنجاح</span>
                </div>
                
                <div className="flex flex-wrap gap-3 no-print justify-start">
                  <button
                    onClick={() => window.print()}
                    className="flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-l from-indigo-600 to-purple-600 text-white font-bold text-sm hover:opacity-90 hover:-translate-y-0.5 transition-all shadow-lg shadow-indigo-500/30"
                  >
                    <Download className="w-4 h-4" />
                    تحميل التقرير
                  </button>
                  <button
                    onClick={handleShare}
                    className="flex items-center gap-2 px-6 py-3 rounded-xl bg-white/5 border border-white/15 text-white font-bold text-sm hover:bg-white/10 hover:-translate-y-0.5 transition-all"
                  >
                    <Share2 className="w-4 h-4" />
                    مشاركة النتيجة
                  </button>
                  <button
                    onClick={() => { resetAssessment(); navigate('/assess/grades'); }}
                    className="flex items-center gap-2 px-6 py-3 rounded-xl bg-white/5 border border-white/15 text-slate-300 font-bold text-sm hover:bg-white/10 hover:-translate-y-0.5 transition-all"
                  >
                    <RefreshCw className="w-4 h-4" />
                    إعادة الاختبار
                  </button>
                </div>
              </div>

