                >
                  <ChevronRight className="w-4 h-4" />
                </button>
                <button
                  onClick={() => scrollCarousel(carouselRef, 'left')}
                  className="w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center hover:bg-white/15 transition-all"
                >
                  <ChevronLeft className="w-4 h-4" />
                </button>
              </div>
            </div>

            <div
              ref={carouselRef}
              className="flex gap-5 overflow-x-auto pb-4 scroll-smooth"
              style={{ scrollbarWidth: 'none', msOverflowStyle: 'none' }}
            >
              {result.fields_ranked.map((field: any, idx: number) => {
                const details = fieldData[field.field_id as FieldId];
                const rank = RANK_COLORS[idx] || RANK_COLORS[0];
                const careers = fieldCareers[field.field_id] || CAREERS_FALLBACK[field.field_id];
                // Tag pills from RIASEC top 3
                const topTraitKeys = riasecListData.slice(0, 3).map(r => r.key);
                const tagTexts = topTraitKeys.map(k => {
                  const t = riasecTraits[k]?.[0]?.text || '';
                  return t.replace('تتمتع بمهارات ', '').replace('لديك حس عالٍ بـ', '').replace('تميل إلى ', '').split(' ').slice(0, 2).join(' ');
                }).filter(Boolean);

                return (
                  <motion.div
                    key={field.field_id}
                    initial={{ opacity: 0, y: 20 }}
                    whileInView={{ opacity: 1, y: 0 }}
                    viewport={{ once: true }}
                    transition={{ delay: idx * 0.1 }}
                    className={`flex-shrink-0 w-72 rounded-2xl p-6 border ${rank.border} flex flex-col gap-4`}
                    style={{
                      background: 'rgba(10, 8, 25, 0.8)',
                      backdropFilter: 'blur(16px)',
                    }}
                  >
                    {/* Rank badge + icon */}
                    <div className="flex items-start justify-between">
                      <div className={`w-10 h-10 rounded-xl bg-gradient-to-br ${rank.bg} flex items-center justify-center text-white font-black text-lg shadow-lg`}>
                        {idx + 1}
                      </div>
                      <div className={`w-12 h-12 rounded-xl bg-gradient-to-br ${rank.bg} bg-opacity-20 flex items-center justify-center`}
                        style={{ background: `${rank.badge}22` }}>
                        <span style={{ color: rank.badge }}>
                          {FIELD_ICONS[field.field_id] || <BookOpen className="w-6 h-6" />}
                        </span>
                      </div>
                    </div>

                    {/* Field name */}
                    <div>
                      <h3 className="font-black text-lg leading-tight mb-1">{details?.name || field.field_id}</h3>
                      <p className="text-slate-500 text-xs line-clamp-2">{details?.description}</p>
                    </div>

                    {/* Score */}
                    <div>
                      <span className="text-3xl font-black text-emerald-400">{Math.round(field.score)}%</span>
                      <span className="text-slate-500 text-xs mr-2">درجة التوافق</span>
                    </div>

                    {/* Tag pills */}
                    <div className="flex flex-wrap gap-1.5">
                      {tagTexts.slice(0, 3).map((tag, ti) => (
                        <span key={ti} className="text-xs px-2.5 py-1 rounded-full bg-white/8 border border-white/10 text-slate-300">
                          {tag}
                        </span>
                      ))}
                    </div>

                    {/* Button */}
                    <button
                      onClick={() => handleFieldExpand(field.field_id)}
                      className="mt-auto w-full py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:opacity-90 hover:-translate-y-0.5 transition-all"
                    >
                      عرض التفاصيل
                    </button>
                  </motion.div>
                );
              })}
            </div>

            {/* Expanded field details (existing logic preserved) */}
            <AnimatePresence>
              {expandedField && (
                <motion.div
                  key={expandedField}
                  initial={{ opacity: 0, height: 0 }}
                  animate={{ opacity: 1, height: 'auto' }}
                  exit={{ opacity: 0, height: 0 }}
                  transition={{ duration: 0.4 }}
                  className="mt-6 overflow-hidden"
                >
                  {(() => {
                    const field = result.fields_ranked.find((f: any) => f.field_id === expandedField);
                    if (!field) return null;
                    const details = fieldData[field.field_id as FieldId];
                    const careers = fieldCareers[field.field_id];
                    const aiMajors = careers?.majors ?? [];
                    const restMajors = (details?.majors ?? []).filter(m => !aiMajors.includes(m));
                    const electiveKey = result.recommended_electives?.[field.field_id];
                    const electiveLabel = electiveKey ? (electiveKeys2[electiveKey as string] || electiveKey) : '-';

                    return (
                      <div
                        className="rounded-2xl p-8 border border-white/10"
                        style={{ background: 'rgba(10, 8, 25, 0.8)', backdropFilter: 'blur(16px)' }}
                      >
                        <div className="flex justify-between items-center mb-6">
                          <h4 className="text-xl font-bold">{details?.name}</h4>
                          <button
                            onClick={() => setExpandedField(null)}
                            className="p-2 rounded-lg hover:bg-white/10 text-slate-400 hover:text-white transition-colors"
                          >
                            <X className="w-5 h-5" />
                          </button>
                        </div>
                        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                          {/* Mandatory subjects */}
                          <div className="space-y-3">
                            <h5 className="flex items-center gap-2 text-indigo-400 font-bold text-sm">
                              <BookOpen className="w-4 h-4" /><span>المواد الوزارية</span>
                            </h5>
                            <div className="p-3 rounded-xl bg-white/5 border border-white/8 space-y-2">
                              {(details?.mandatory_subjects ?? []).map((subject, i) => (
                                <div key={i} className="flex items-center gap-2 text-sm text-slate-200">
                                  <span className="w-5 h-5 rounded-full bg-indigo-500/20 text-indigo-400 text-xs font-black flex items-center justify-center">{i + 1}</span>
                                  {subject}
                                </div>
                              ))}
                            </div>
                            <div className="p-4 rounded-xl bg-indigo-500/5 border border-indigo-500/10">
                              <span className="text-xs text-indigo-400 font-bold block mb-1">المادة الاختيارية الموصى بها</span>
                              <span className="text-lg font-bold">{electiveLabel}</span>
                            </div>
                          </div>
                          {/* Jobs */}
                          <div className="space-y-3">
                            <h5 className="flex items-center gap-2 text-amber-400 font-bold text-sm">
                              <Briefcase className="w-4 h-4" /><span>أبرز الوظائف بعد التخرج</span>
                            </h5>
                            {loadingCareers === field.field_id ? (
                              <div className="flex items-center gap-2 text-slate-400 text-sm py-3">
                                <Loader2 className="w-4 h-4 animate-spin" /><span>جاري التحميل...</span>
                              </div>
                            ) : careers?.jobs?.length ? (
                              <div className="space-y-2">
                                {careers.jobs.map((job, i) => (
                                  <div key={i} className="flex items-center gap-3 p-3 rounded-xl bg-amber-500/5 border border-amber-500/10">
                                    <span className="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 text-xs font-black flex items-center justify-center">{i + 1}</span>
                                    <span className="text-sm text-slate-200">{job}</span>
                                  </div>
                                ))}
                              </div>
                            ) : (
                              <p className="text-slate-600 text-sm">جاري جلب البيانات...</p>
                            )}
                          </div>
                          {/* AI majors */}
                          <div className="space-y-3">
                            <h5 className="flex items-center gap-2 text-emerald-400 font-bold text-sm">
                              <Sparkles className="w-4 h-4" /><span>أفضل 3 تخصصات موصى بها</span>
                            </h5>
                            {loadingCareers === field.field_id ? (
                              <div className="flex items-center gap-2 text-slate-400 text-sm py-3">
                                <Loader2 className="w-4 h-4 animate-spin" /><span>جاري التحميل...</span>
                              </div>
                            ) : aiMajors.length ? (
                              <div className="space-y-2">
                                {aiMajors.map((major, i) => (
                                  <button key={i} type="button"
                                    onClick={() => handleMajorClick(major)}
                                    className="w-full flex items-center gap-3 p-3 rounded-xl bg-emerald-500/5 border border-emerald-500/20 hover:bg-emerald-500/15 transition-all text-right group"
                                  >
                                    <span className="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-black flex items-center justify-center">{i + 1}</span>
                                    <span className="text-sm text-slate-200 group-hover:text-white transition-colors flex-1">{major}</span>
                                    <ChevronRight className="w-3 h-3 text-emerald-500/40 group-hover:text-emerald-400 transition-colors" />
                                  </button>
                                ))}
                              </div>
                            ) : (
                              <p className="text-slate-600 text-sm">�          {/* ═══════════════════════════════════════════════════════════
              6. BOTTOM 2-COLUMN
          ════════════════════════════════════════════════════════════ */}
          <motion.section
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.6 }}
            className="grid grid-cols-1 md:grid-cols-2 gap-6 no-print"
          >
            {/* Col 1: Next Steps */}
            <div
              className="rounded-2xl p-6 border border-white/8"
              style={{ background: 'rgba(10, 8, 25, 0.7)', backdropFilter: 'blur(12px)' }}
            >
              <h3 className="text-lg font-black mb-6 flex items-center gap-2">
                <CheckCircle className="w-5 h-5 text-indigo-400" />
                خطواتك القادمة
              </h3>
              <div className="space-y-4">
                {[
                  { label: 'أكمل إجراءات الاختيار', done: false },
                  { label: 'تم تحليل شخصيتك', done: true },
                  { label: 'تم اختيار أفضل المسارات لك', done: true },
                  { label: 'تعرف على الجامعات والتخصصات', done: false },
                ].map((step, i) => (
                  <div key={i} className="flex items-start gap-3">
                    <div className={`w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-black mt-0.5 ${step.done ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-indigo-500/15 text-indigo-400 border border-indigo-500/25'}`}>
                      {step.done ? '✓' : i + 1}
                    </div>
                    <span className={`text-sm mt-1 ${step.done ? 'text-emerald-400' : 'text-slate-300'}`}>
                      {step.label}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            {/* Col 2: AI Advisor */}
            <div
              className="rounded-2xl p-6 relative overflow-hidden flex flex-col"
              style={{
                background: 'linear-gradient(135deg, rgba(99,102,241,0.3) 0%, rgba(139,92,246,0.3) 100%)',
                border: '1px solid rgba(139, 92, 246, 0.3)',
                backdropFilter: 'blur(12px)',
              }}
            >
              {/* Glow orb */}
              <div className="absolute top-0 left-0 w-40 h-40 bg-purple-500/20 rounded-full blur-3xl" />
              <div className="relative">
                <h3 className="text-lg font-black mb-2">المستشار الذكي</h3>
                <p className="text-slate-300 text-sm mb-6 leading-relaxed">
                  اسأل مستشارك الأكاديمي الرقمي عن أي شيء يتعلق بنتائجك والمسارات المتاحة.
                </p>
                {/* Robot illustration */}
                <div className="flex justify-center mb-6">
                  <div className="w-20 h-20 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center text-4xl shadow-lg">
                    🤖
                  </div>
                </div>
                <button
                  onClick={() => setIsChatOpen(true)}
                  className="w-full py-3 rounded-xl font-bold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:opacity-90 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 mb-3"
                >
                  <MessageSquare className="w-4 h-4" />
                  ابدأ المحادثة
                </button>
                <p className="text-center text-xs text-slate-400">⏰ متاح على مدار الساعة</p>
              </div>
            </div>
          </motion.section>assName="mt-auto w-full py-2 rounded-xl text-xs font-bold text-purple-300 border border-purple-500/25 bg-purple-500/8 hover:bg-purple-500/20 transition-all">
                    عرض التخصصات
                  </button>
                </motion.div>
              ))}
            </div>
          </motion.section>

          {/* ═══════════════════════════════════════════════════════════
              7. BOTTOM 3-COLUMN
          ════════════════════════════════════════════════════════════ */}
          <motion.section
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.6 }}
            className="grid grid-cols-1 md:grid-cols-3 gap-6 no-print"
          >
            {/* Col 1: Next Steps */}
            <div
              className="rounded-2xl p-6 border border-white/8"
              style={{ background: 'rgba(10, 8, 25, 0.7)', backdropFilter: 'blur(12px)' }}
            >
              <h3 className="text-lg font-black mb-6 flex items-center gap-2">
                <CheckCircle className="w-5 h-5 text-indigo-400" />
                خطواتك القادمة
              </h3>
              <div className="space-y-4">
                {[
                  { label: 'أكمل إجراءات الاختيار', done: false },
                  { label: 'تم تحليل شخصيتك', done: true },
                  { label: 'تم اختيار أفضل المسارات لك', done: true },
                  { label: 'تعرف على الجامعات والتخصصات', done: false },
                ].map((step, i) => (
                  <div key={i} className="flex items-start gap-3">
                    <div className={`w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-black mt-0.5 ${step.done ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-indigo-500/15 text-indigo-400 border border-indigo-500/25'}`}>
                      {step.done ? '✓' : i + 1}
                    </div>
                    <span className={`text-sm mt-1 ${step.done ? 'text-emerald-400' : 'text-slate-300'}`}>
                      {step.label}
                      {step.done && <span className="text-xs mr-1 opacity-60">✅</span>}
                    </span>
                  </div>
                ))}
              </div>
            </div>

            {/* Col 2: AI Advisor */}
            <div
              className="rounded-2xl p-6 relative overflow-hidden flex flex-col"
              style={{
                background: 'linear-gradient(135deg, rgba(99,102,241,0.3) 0%, rgba(139,92,246,0.3) 100%)',
                border: '1px solid rgba(139, 92, 246, 0.3)',
                backdropFilter: 'blur(12px)',
              }}
            >
              {/* Glow orb */}
              <div className="absolute top-0 left-0 w-40 h-40 bg-purple-500/20 rounded-full blur-3xl" />
              <div className="relative">
                <h3 className="text-lg font-black mb-2">المستشار الذكي</h3>
                <p className="text-slate-300 text-sm mb-6 leading-relaxed">
                  اسأل مستشارك الأكاديمي الرقمي عن أي شيء يتعلق بنتائجك والمسارات المتاحة.
                </p>
                {/* Robot illustration */}
                <div className="flex justify-center mb-6">
                  <div className="w-20 h-20 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center text-4xl shadow-lg">
                    🤖
                  </div>
                </div>
                <button
                  onClick={() => setIsChatOpen(true)}
                  className="w-full py-3 rounded-xl font-bold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:opacity-90 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 mb-3"
                >
                  <MessageSquare className="w-4 h-4" />
                  ابدأ المحادثة
                </button>
                <p className="text-center text-xs text-slate-400">⏰ متاح على مدار الساعة</p>
              </div>
            </div>

            {/* Col 3: Important Reminder */}
            <div
              className="rounded-2xl p-6 relative overflow-hidden flex flex-col"
              style={{
                background: 'rgba(10, 8, 25, 0.85)',
                border: '1px solid rgba(255,255,255,0.08)',
                backdropFilter: 'blur(12px)',
              }}
            >
              {/* Brain decoration */}
              <div className="absolute bottom-0 left-0 text-8xl opacity-5 select-none pointer-events-none">🧠</div>

              <div className="relative flex-1 flex flex-col">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/25 flex items-center justify-center">
                    <Bell className="w-5 h-5 text-amber-400" />
                  </div>
                  <h3 className="text-lg font-black">تذكير مهم</h3>
                </div>
                <p className="text-slate-400 text-sm leading-loose flex-1">
                  هذه النتائج هي دليل يساعدك في اتخاذ قرارات، لكن مستقبلك يصنعه قدراتك واختياراتك الواعية.
                  استشر معلميك وذويك قبل اتخاذ قرارك النهائي.
                </p>
                <button
                  onClick={() => window.print()}
                  className="mt-6 w-full py-2.5 rounded-xl text-sm font-bold text-white border border-white/12 bg-white/5 hover:bg-white/10 transition-all flex items-center justify-center gap-2"
                >
                  <Download className="w-4 h-4" />
                  احفظ النتيجة
                </button>
              </div>
            </div>
          </motion.section>

        </div>{/* end max-w-7xl */}
      </div>{/* end relative z-10 */}

      {/* ═══════════════════════════════════════════════════════════
          MAJOR MODAL (unchanged logic)
      ════════════════════════════════════════════════════════════ */}
      <AnimatePresence>
        {selectedMajor && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
              onClick={() => setSelectedMajor(null)}
              className="absolute inset-0 bg-black/80 backdrop-blur-sm" />
            <motion.div initial={{ opacity: 0, scale: 0.9, y: 20 }} animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className="relative w-full max-w-lg rounded-2xl p-8 border border-white/15 shadow-2xl"
              style={{ background: 'rgba(10, 5, 30, 0.95)', backdropFilter: 'blur(24px)' }}
              dir="rtl"
            >
              <button onClick={() => setSelectedMajor(null)}
                className="absolute top-4 left-4 p-2 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors">
                <X className="w-5 h-5" />
              </button>
              <h3 className="text-2xl font-bold mb-6 text-cyan-400 flex items-center gap-3">
                <GraduationCap className="w-6 h-6" /><span>{selectedMajor}</span>
              </h3>
              {loadingDesc ? (
                <div className="py-12 flex flex-col items-center gap-4">
                  <Loader2 className="w-8 h-8 text-cyan-500 animate-spin" />
                  <p className="text-slate-400 text-sm">جاري جلب تفاصيل التخصص...</p>
                </div>
              ) : (
                <div className="text-slate-300 leading-relaxed max-h-[60vh] overflow-y-auto">
                  <p className="whitespace-pre-line text-lg">{majorDesc}</p>
                </div>
              )}
              <button onClick={() => setSelectedMajor(null)} className="btn-google w-full mt-8">إغلاق</button>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* ═══════════════════════════════════════════════════════════
          CHATBOT (unchanged logic)
      ════════════════════════════════════════════════════════════ */}
      <AnimatePresence>
        {isChatOpen && (
          <>
            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
              onClick={() => setIsChatOpen(false)}
              className="fixed inset-0 z-[109] bg-black/40 backdrop-blur-sm" />
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 100 }} animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 100 }}
              className="fixed bottom-4 left-4 md:bottom-8 md:left-8 z-[110] w-full max-w-md h-[420px] rounded-2xl border border-indigo-500/30 flex flex-col shadow-2xl overflow-hidden"
              style={{ background: 'rgba(8, 5, 25, 0.97)', backdropFilter: 'blur(24px)' }}
              dir="rtl"
            >
              <div className="p-4 border-b border-white/10 bg-indigo-500/10 flex justify-between items-center flex-shrink-0">
                <div className="flex items-center gap-3">
                  <div className="w-8 h-8 rounded-lg bg-indigo-500 flex items-center justify-center">
                    <MessageSquare className="w-4 h-4 text-white" />
                  </div>
                  <div>
                    <h4 className="font-bold text-sm">المستشار الأكاديمي الذكي</h4>
                    <span className="text-[10px] text-emerald-400 flex items-center gap-1">
                      <div className="w-1 h-1 rounded-full bg-emerald-400 animate-pulse" />متصل الآن
                    </span>
                  </div>
                </div>
                <button onClick={() => setIsChatOpen(false)}
                  className="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors">
                  <X className="w-5 h-5" />
                </button>
              </div>
              <div className="flex-1 overflow-y-auto p-4 space-y-4">
                {chatMessages.length === 0 && (
                  <div className="text-center py-10 space-y-3">
                    <div className="w-14 h-14 rounded-2xl bg-indigo-500/20 flex items-center justify-center mx-auto text-indigo-400">
                      <Sparkles className="w-7 h-7" />
                    </div>
                    <div>
                      <p className="text-base font-bold">أهلاً بك في طريق التوجيهي!</p>
                      <p className="text-sm text-slate-400">اسألني أي شيء عن نتائجك أو التخصصات.</p>
                    </div>
                  </div>
                )}
                {chatMessages.map((msg, i) => (
                  <div key={i} className={`flex ${msg.role === 'user' ? 'justify-start' : 'justify-end'}`}>
                    <div className={`max-w-[85%] p-3 rounded-2xl text-sm ${msg.role === 'user'
                      ? 'bg-indigo-600/20 border border-indigo-500/20 rounded-tr-none'
                      : 'bg-white/5 border border-white/10 rounded-tl-none'}`}>
                      <p className="whitespace-pre-line leading-relaxed">{msg.content}</p>
                    </div>
                  </div>
                ))}
                {isTyping && (
                  <div className="flex justify-end">
                    <div className="bg-white/5 border border-white/10 p-3 rounded-2xl rounded-tl-none flex gap-1">
                      <div className="w-1.5 h-1.5 rounded-full bg-slate-500 animate-bounce" />
                      <div className="w-1.5 h-1.5 rounded-full bg-slate-500 animate-bounce [animation-delay:0.2s]" />
                      <div className="w-1.5 h-1.5 rounded-full bg-slate-500 animate-bounce [animation-delay:0.4s]" />
                    </div>
                  </div>
                )}
                <div ref={chatEndRef} />
              </div>
              <form onSubmit={handleSendMessage} className="p-4 border-t border-white/10 bg-white/5 flex-shrink-0">
                <div className="relative">
                  <input type="text" value={chatInput} onChange={e => setChatInput(e.target.value)}
                    placeholder="اسأل مستشارك عن مسارك..."
                    className="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-indigo-500/50 transition-colors" />
                  <button type="submit" disabled={isTyping || !chatInput.trim()}
                    className="absolute left-2 top-1.5 p-1.5 bg-indigo-500 text-white rounded-lg hover:bg-indigo-400 disabled:opacity-50 transition-colors">
                    <ChevronRight className="w-4 h-4" />
                  </button>
                </div>
              </form>
            </motion.div>
          </>
        )}
      </AnimatePresence>
    </div>
  );
}