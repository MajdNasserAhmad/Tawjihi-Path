                      <motion.div
                        key={i}
                        initial={{ opacity: 0, x: -10 }}
                        whileInView={{ opacity: 1, x: 0 }}
                        viewport={{ once: true }}
                        transition={{ delay: i * 0.08 }}
                        className="flex items-center gap-3 p-2.5 rounded-xl bg-white/5 border border-white/8"
                      >
                        <span className="text-lg flex-shrink-0">{bullet.icon}</span>
                        <span className="text-xs text-slate-300 font-medium">{bullet.text}</span>
                      </motion.div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </motion.section>

          {/* ═══════════════════════════════════════════════════════════
