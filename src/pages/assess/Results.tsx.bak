                      strokeWidth={2}
                      dot={{ fill: 'white', r: 4, strokeWidth: 0 }}
                    />
                    <Tooltip
                      contentStyle={{ background: '#0f0820', border: '1px solid rgba(168,85,247,0.3)', borderRadius: 12, fontFamily: 'Cairo' }}
                      formatter={(val: number) => [`${Math.round(val)}%`, '']}
                    />
                  </RadarChart>
                </ResponsiveContainer>
              </motion.div>

              {/* RIASEC Radar */}
              <motion.div
                initial={{ opacity: 0, x: -30 }}
                whileInView={{ opacity: 1, x: 0 }}
                viewport={{ once: true }}
                transition={{ delay: 0.2 }}
                className="rounded-2xl p-6"
                style={{
                  background: 'rgba(10, 8, 25, 0.7)',
                  backdropFilter: 'blur(16px)',
                  border: '1px solid rgba(255,255,255,0.08)',
                }}
              >
                <h3 className="text-lg font-bold flex items-center gap-2 mb-6">
                  <TrendingUp className="w-5 h-5 text-cyan-400" />
                  بصمة ميولك المهنية (RIASEC)
                </h3>
                <ResponsiveContainer width="100%" height={280}>
                  <RadarChart data={riasecRadarData} cx="50%" cy="50%" outerRadius="75%">
                    <PolarGrid stroke="rgba(255,255,255,0.08)" />
                    <PolarAngleAxis
                      dataKey="subject"
                      tick={{ fill: '#94a3b8', fontSize: 12, fontFamily: 'Cairo' }}
